<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The share queue, the contact list the share sheet shows, and the
	     visibility the tile and widget read: nothing secret. The storage key
	     stays in the app's own Keychain group, which extensions cannot read. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.org.todoke.ios</string>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share: contacts published as sharing shortcuts in this category
     are offered as targets for any file. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="org.todoke.android.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="org.todoke.android.SHARE_TARGET" />
    </share-target>
</shortcuts>

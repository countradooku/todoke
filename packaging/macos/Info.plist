<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- todoke.app's Info.plist. build-app.sh replaces @VERSION@. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>todoke</string>
	<key>CFBundleExecutable</key>
	<string>todoke-desktop</string>
	<key>CFBundleIconFile</key>
	<string>todoke</string>
	<key>CFBundleIdentifier</key>
	<string>org.todoke.todoke</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>todoke</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>MacOSX</string>
	</array>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<!-- SMAppService (the login item) needs macOS 13. -->
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © the todoke contributors. Apache-2.0 OR MIT.</string>
	<!-- Local network privacy (macOS 15): nearby devices over mDNS. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>todoke finds your devices on the local network to send files to them.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_todoke._tcp</string>
	</array>
	<!-- Finder's Quick Action and the Services menu (todoke-sys-macos services.rs). -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Send with todoke</string>
			</dict>
			<key>NSMessage</key>
			<string>sendFiles</string>
			<key>NSPortName</key>
			<string>todoke</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Send text with todoke</string>
			</dict>
			<key>NSMessage</key>
			<string>sendText</string>
			<key>NSPortName</key>
			<string>todoke</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
		</dict>
	</array>
	<!-- Listed in Open With for every file and folder, owning none. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>File or folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.item</string>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="utf-8"?>
<!-- Template: build-msix.ps1 replaces @VERSION@ (four parts), @PUBLISHER@
     (the signing certificate's subject), and @ARCH@ (x64 or arm64), and
     removes the SHELL block when todoke_shell.dll is not staged. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap uap5 rescap desktop desktop4 desktop5 com">

  <Identity
    Name="org.todoke.todoke"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="@ARCH@" />

  <Properties>
    <DisplayName>todoke</DisplayName>
    <PublisherDisplayName>todoke</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- The Explorer command (desktop4/desktop5) needs 10.0.19041; older
         versions ignore it. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="todoke" Executable="todoke-desktop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="todoke"
        Description="End-to-end encrypted file transfer between your devices"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="todoke-desktop.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
        <!-- Off until the app's settings turn it on (StartupTask API). -->
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="todoke" Enabled="false" DisplayName="todoke" />
        </desktop:Extension>
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget Description="Send with todoke">
            <uap:SupportedFileTypes>
              <uap:SupportsAnyFileType />
            </uap:SupportedFileTypes>
            <uap:DataFormat>StorageItems</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>
        <!-- @SHELL_BEGIN@ "Send with todoke" in Explorer: an IExplorerCommand
             in todoke_shell.dll, hosted by a COM surrogate. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="SendWithTodoke" Clsid="346A1ED9-A65C-4480-B1DE-A792C18293C8" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="SendWithTodoke" Clsid="346A1ED9-A65C-4480-B1DE-A792C18293C8" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="todoke shell">
              <com:Class Id="346A1ED9-A65C-4480-B1DE-A792C18293C8" Path="todoke_shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <!-- @SHELL_END@ -->
      </Extensions>
    </Application>

    <!-- The command line: only an alias, no Start menu entry. -->
    <Application Id="cli" Executable="todoke.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="todoke (command line)"
        Description="The todoke command line"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="todoke.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A full-trust app has no sandbox to declare network access for. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
